rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAforaOperations(orgId, projectId) {
      return orgId == 'afora' && projectId == 'urban_operations';
    }

    match /asd_organizations/{orgId} {
      allow read: if signedIn() && orgId == 'afora';
      allow write: if false;

      match /projects/{projectId} {
        allow read: if signedIn() && isAforaOperations(orgId, projectId);
        allow write: if false;

        match /trips/{tripId} {
          allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
          allow delete: if false;

          match /events/{eventId} {
            allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
            allow delete: if false;
          }

          match /track_chunks/{chunkId} {
            allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
            allow delete: if false;
          }

          match /telemetry/{documentId} {
            allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
            allow delete: if false;
          }
        }

        // Field devices consume the catalog but never author it.
        // Web/admin tooling can migrate the current legacy catalog into this
        // project-scoped location without changing the Android contract.
        match /catalog_versions/{document=**} {
          allow read: if signedIn() && isAforaOperations(orgId, projectId);
          allow write: if false;
        }

        match /installations/{installationId} {
          allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
          allow delete: if false;

          match /live/{document=**} {
            allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
            allow delete: if false;
          }
        }

        match /live_status/{document=**} {
          allow read, create, update: if signedIn() && isAforaOperations(orgId, projectId);
          allow delete: if false;
        }
      }
    }

    // Temporary read-only compatibility window for the pre-RC2 catalog.
    // Remove after asd_catalog_versions/current has been migrated to the
    // project-scoped catalog_versions/current document.
    match /asd_catalog_versions/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
