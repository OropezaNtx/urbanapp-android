rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /installations/{installationId} {
      allow get: if request.auth != null && (
        isAdmin() || 
        resource.data.ownerUid == request.auth.uid
      );
      
      allow list: if isAdmin();
      
      allow create: if request.auth != null
        && request.resource.data.status == 'PENDING'
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['licenseId', 'workspaceId'])
        && request.resource.data.installationId == installationId;
      
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastSeen', 'lastSeenClient', 'lastHeartbeatAt', 'lastSyncAt', 'lastLicenseCheckAt', 'activeTripId', 'battery', 'device', 'config', 'installationVersion'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('licenseId', null) == resource.data.get('licenseId', null)
        && request.resource.data.get('workspaceId', null) == resource.data.get('workspaceId', null);
        
      allow write: if isAdmin();
    }

    // Secure Licenses: 
    // Android can read a license ONLY if they own an ACTIVE installation linked to it.
    // The installationId MUST be passed in the query filters.
    match /licenses/{licenseId} {
      allow list: if request.auth != null && (
        isAdmin() || 
        (
          exists(/databases/$(database)/documents/installations/$(request.query.installationId)) &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.licenseId == licenseId &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.status == 'ACTIVE'
        )
      );
      
      allow get: if isAdmin();
      allow write: if isAdmin();
    }

    // Secure Workspaces:
    // Android can read the workspace ONLY if they own an ACTIVE installation linked to it.
    match /workspaces/{workspaceId} {
      allow list: if request.auth != null && (
        isAdmin() || 
        (
          exists(/databases/$(database)/documents/installations/$(request.query.installationId)) &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.workspaceId == workspaceId &&
          get(/databases/$(database)/documents/installations/$(request.query.installationId)).data.status == 'ACTIVE'
        )
      );
      
      allow get: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
