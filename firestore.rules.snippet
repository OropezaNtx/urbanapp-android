rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Device Metadata (Read-only for users, scoped by ownerUid)
    match /installations/{installationId} {
      allow get: if request.auth != null && (
        isAdmin() || 
        resource.data.ownerUid == request.auth.uid
      );
      
      allow list: if isAdmin();
      
      allow create: if request.auth != null
        && request.resource.data.status == 'PENDING'
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['licenseId', 'workspaceId'])
        && request.resource.data.installationId == installationId;
      
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastSeen', 'lastSeenClient', 'lastHeartbeatAt', 'lastSyncAt', 'lastLicenseCheckAt', 'activeTripId', 'battery', 'device', 'config', 'installationVersion'])
        && request.resource.data.status == resource.data.status;
        
      allow write: if isAdmin();
    }

    // PRIMARY AUTHORIZATION GATE (Keyed by ownerUid)
    match /installation_access/{uid} {
      allow get: if request.auth != null && (isAdmin() || request.auth.uid == uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Secure Licenses: Gated by the installation_access document
    match /licenses/{licenseId} {
      allow get: if request.auth != null && (
        isAdmin() || 
        (
          get(/databases/$(database)/documents/installation_access/$(request.auth.uid)).data.licenseId == licenseId &&
          get(/databases/$(database)/documents/installation_access/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );
      
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Secure Workspaces: Gated by the installation_access document
    match /workspaces/{workspaceId} {
      allow get: if request.auth != null && (
        isAdmin() || 
        (
          get(/databases/$(database)/documents/installation_access/$(request.auth.uid)).data.workspaceId == workspaceId &&
          get(/databases/$(database)/documents/installation_access/$(request.auth.uid)).data.status == 'ACTIVE'
        )
      );

      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
