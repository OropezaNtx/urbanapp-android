rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Installations: 
    // - Android can only read its OWN document
    // - Android can create its own (PENDING, no license/workspace)
    // - Android can only update telemetry fields
    // - status, licenseId, workspaceId are READ-ONLY for Android
    match /installations/{installationId} {
      // Scoped read: allows fetching specific doc if you know the ID.
      // In Phase 1 without Auth, we allow "get" but not "list".
      allow get: if true; 
      allow list: if isAdmin();
      
      allow create: if request.resource.data.status == 'PENDING'
        && !('licenseId' in request.resource.data)
        && !('workspaceId' in request.resource.data)
        && request.resource.data.installationId == installationId;
      
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastSeen', 'lastSeenClient', 'lastHeartbeatAt', 'lastSyncAt', 'lastLicenseCheckAt', 'activeTripId', 'battery', 'device', 'config', 'installationVersion'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.licenseId == resource.data.licenseId
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow write: if isAdmin();
    }

    // Licenses:
    // - Android can only read
    // - Admin can manage
    match /licenses/{licenseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Workspaces:
    // - Android can only read
    // - Admin can manage
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
